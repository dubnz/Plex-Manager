# Runtime mode
# Set to true for local UI/backend demo data without external services.
PLEX_MANAGER_DEMO_MODE=false

# Plex
PLEX_URL=http://plex.example.local:32400
PLEX_TOKEN=replace-me
PLEX_LIBRARY_NAMES=Movies,TV Shows

# Tautulli
TAUTULLI_URL=http://tautulli.example.local:8181
TAUTULLI_API_KEY=replace-me

# Sonarr
SONARR_URL=http://sonarr.example.local:8989
SONARR_API_KEY=replace-me

# Radarr
RADARR_URL=http://radarr.example.local:7878
RADARR_API_KEY=replace-me

# Seerr: must be exactly "overseerr" or "jellyseerr".
SEERR_KIND=overseerr
SEERR_URL=http://seerr.example.local:5055
SEERR_API_KEY=replace-me

# Local cache
DB_PATH=/var/lib/plex-manager/plex-manager.db
CONFIG_PATH=/var/lib/plex-manager/config.json
SYNC_INTERVAL_MINUTES=60
